{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BehindTheMusicTree/grow-the-music-tree-api/main/grow/schemas/artist.schema.json",
  "title": "Artist",
  "description": "One row of 3_artists/part-NNNNN.ndjson.gz",
  "$defs": {
    "mbid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -32768,
      "maximum": 32767
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "musicbrainz_artist_id",
    "name",
    "type",
    "country",
    "begin_year",
    "end_year",
    "ended",
    "disambiguation",
    "aliases",
    "members",
    "links",
    "release_groups",
    "image",
    "origin"
  ],
  "properties": {
    "origin": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name",
        "musicbrainz_area_id",
        "kind",
        "source",
        "wikidata_id",
        "longitude",
        "latitude",
        "region_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "musicbrainz_area_id": {
          "$ref": "#/$defs/mbid"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source": {
          "enum": [
            "begin_area",
            "area"
          ]
        },
        "wikidata_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^Q[1-9][0-9]*$"
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "region_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "musicbrainz_artist_id": {
      "$ref": "#/$defs/mbid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "type": {
      "enum": [
        "person",
        "group",
        "orchestra",
        "choir",
        "character",
        "other",
        null
      ]
    },
    "country": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{2}$"
    },
    "begin_year": {
      "$ref": "#/$defs/year"
    },
    "end_year": {
      "$ref": "#/$defs/year"
    },
    "ended": {
      "type": "boolean"
    },
    "disambiguation": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 2048
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "musicbrainz_artist_id",
          "begin_year",
          "end_year",
          "ended",
          "roles"
        ],
        "properties": {
          "musicbrainz_artist_id": {
            "$ref": "#/$defs/mbid"
          },
          "begin_year": {
            "$ref": "#/$defs/year"
          },
          "end_year": {
            "$ref": "#/$defs/year"
          },
          "ended": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "url"
        ],
        "properties": {
          "kind": {
            "enum": [
              "official",
              "wikipedia",
              "wikidata",
              "spotify",
              "youtube",
              "bandcamp",
              "soundcloud",
              "discogs",
              "social"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https?://",
            "maxLength": 2048
          }
        }
      }
    },
    "release_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "musicbrainz_release_group_id",
          "title",
          "primary_type",
          "secondary_types",
          "first_release_year"
        ],
        "properties": {
          "musicbrainz_release_group_id": {
            "$ref": "#/$defs/mbid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "primary_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "secondary_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "first_release_year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1000,
            "maximum": 9999
          }
        }
      }
    },
    "image": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "page_url",
            "author",
            "license",
            "license_url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "page_url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "author": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "license_url": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^https?://",
              "maxLength": 2048
            }
          }
        }
      ]
    }
  }
}
