{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/BehindTheMusicTree/grow-the-music-tree-api/main/grow/schemas/hidden_regions.schema.json",
  "title": "Hidden regions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "regions"
  ],
  "properties": {
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "parentId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "admin_unit",
              "country"
            ]
          },
          "parentId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
