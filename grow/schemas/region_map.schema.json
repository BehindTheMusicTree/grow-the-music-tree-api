{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/BehindTheMusicTree/grow-the-music-tree-api/main/grow/schemas/region_map.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "regions",
    "tileset",
    "worldChildIds",
    "worldZoneIds"
  ],
  "definitions": {
    "box": {
      "type": "array",
      "items": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 360
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "properties": {
    "tileset": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "worldChildIds": {
      "$ref": "#/definitions/ids"
    },
    "worldZoneIds": {
      "$ref": "#/definitions/ids"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "parentId",
          "childIds",
          "zoneIds",
          "bbox",
          "centroid",
          "overviewItemId",
          "inheritedOverviewItemId",
          "genres",
          "songCount",
          "genreCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "country",
              "admin_unit",
              "zone",
              "city"
            ]
          },
          "isoCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "childIds": {
            "$ref": "#/definitions/ids"
          },
          "zoneIds": {
            "$ref": "#/definitions/ids"
          },
          "cityIds": {
            "$ref": "#/definitions/ids"
          },
          "bbox": {
            "anyOf": [
              {
                "$ref": "#/definitions/box"
              },
              {
                "type": "null"
              }
            ]
          },
          "mainBbox": {
            "$ref": "#/definitions/box"
          },
          "centroid": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "overviewItemId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "inheritedOverviewItemId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemId",
                "relation"
              ],
              "properties": {
                "itemId": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "enum": [
                    "canonical",
                    "regional",
                    "tradition"
                  ]
                }
              }
            }
          },
          "songCount": {
            "type": "integer",
            "minimum": 0
          },
          "genreCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "bbox": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "centroid": {
                  "type": "null"
                },
                "mainBbox": false
              }
            },
            "else": {
              "properties": {
                "centroid": {
                  "type": "array"
                }
              }
            }
          }
        ]
      }
    }
  }
}
